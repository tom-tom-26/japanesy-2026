DTSTART;TZID=Asia/Tokyo:20261109T190000
DTEND;TZID=Asia/Tokyo:20261109T203000
SUMMARY:Dinner: Gion Duck Noodles
LOCATION:329 Gionmachi Kitagawa\, 1F unit D\, Higashiyama-ku\, Kyoto 605-00
 73
DESCRIPTION:Specialty: duck tsukemen/ramen — Kishu duck\, handmade German
 -rye noodles.\n4.5/5 Tripadvisor\, ranked among Kyoto's top restaurants.\n
 Small and hidden with a regular queue even in winter — go right at openi
 ng or expect a wait. No reservation.\n4 min walk from Gion-Shijo Station.\
 nMap: https://www.google.com/maps/search/?api=1&query=Gion+Duck+Noodles+Ky
 oto
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Dinner: Gion Duck Noodles
TRIGGER:-PT30M
END:VALARM
END:VEVENT
